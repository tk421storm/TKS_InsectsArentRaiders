<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Aggressive hive defense: patrol up to 35 cells from the hive (vanilla 7.5; the leash is 40) and jog instead of walk
       (twice as fast; vanilla attack jobs already jog). Our own job giver: vanilla's wander finder warns above 12 cells -->
  <Operation Class="PatchOperationAttributeSet">
    <xpath>Defs/DutyDef[defName="DefendHiveAggressively"]/thinkNode/subNodes/li[@Class="JobGiver_WanderHive"]</xpath>
    <attribute>Class</attribute>
    <value>TKS_InsectsArentRaiders.JobGiver_InsectPatrolHive</value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/DutyDef[defName="DefendHiveAggressively"]/thinkNode/subNodes/li[@Class="TKS_InsectsArentRaiders.JobGiver_InsectPatrolHive"]</xpath>
    <value>
      <patrolRadius>35</patrolRadius>
      <locomotionUrgency>Jog</locomotionUrgency>
    </value>
  </Operation>

</Patch>
